# =============================================================================
# SentryGuardian 环境变量模板
# 复制为 .env 后按需修改。完整说明见 docs/configuration.md
# =============================================================================

# --- 数据库（backend-dsn / backend-monitor 必填）---
DATABASE_URL=postgresql://sentryguardian:sentryguardian@localhost:5432/sentryguardian

# --- 种子数据 db:seed（首次初始化）---
SEED_ADMIN_EMAIL=admin@localhost
SEED_ADMIN_PASSWORD=adminadmin
# 写入 DSN 的 ingest 主机，格式 host:port（无 https）
SEED_INGEST_HOST=localhost:3001

# --- backend/dsn（ingest，默认 :3001）---
DSN_PORT=3001
# 单条 Envelope 最大字节，默认 1048576（1MB）
# MAX_ENVELOPE_BYTES=1048576
# 浏览器跨域；开发可用 *，生产填控制台域名
CORS_ORIGIN=*

# --- backend/monitor（API + Grouper，默认 :3002）---
MONITOR_PORT=3002
# 生产必须更换为强随机串
JWT_SECRET=dev-secret-change-me
# 未聚合 Event 轮询间隔（毫秒）
# GROUPER_POLL_MS=3000

# --- frontend/monitor（Vite 构建/开发）---
# 生产构建时指向 monitor API 根地址；开发留空走代理
# VITE_API_URL=https://monitor.example.com

# --- examples/vanilla（仅运行示例时需要）---
# VITE_DSN=https://<publicKey>@localhost:3001/api/<projectId>
