// Prisma schema for SentryGuardian Lite (PostgreSQL).
// SentryGuardian Lite 元数据与 Event 存储（PostgreSQL）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Console login boundary (MVP: single org per instance).
/// 控制台登录边界（MVP：每实例通常一个组织）。
model Organization {
  id        String   @id @default(cuid())
  /// Display name shown in the console. 控制台展示名称。
  name      String
  /// URL-safe unique slug. URL 安全的唯一标识。
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users    User[]
  projects Project[]

  @@map("organizations")
}

/// Console user; credentials separate from DSN keys.
/// 控制台用户；凭据与 DSN Key 分离。
model User {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  /// Login email (unique per instance). 登录邮箱（实例内唯一）。
  email          String   @unique
  /// bcrypt password hash. bcrypt 密码哈希。
  passwordHash   String   @map("password_hash")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("users")
}

/// Monitored application; owns ingest DSN and issues.
/// 被监控的应用；持有 ingest DSN 与 Issue。
model Project {
  id                 String   @id @default(cuid())
  organizationId     String   @map("organization_id")
  /// Human-readable project name. 项目名称。
  name               String
  /// URL-safe slug unique within the organization. 组织内唯一的 slug。
  slug               String
  /// Public key embedded in the DSN (ingest auth). DSN 中的 public key（ingest 鉴权）。
  publicKey          String   @unique @map("public_key")
  /// CORS allowed origins; empty means allow all (dev). CORS 白名单。
  allowedOrigins     String[] @default([]) @map("allowed_origins")
  /// Max ingest requests per minute per project. 每项目每分钟 ingest 上限。
  rateLimitPerMinute Int      @default(100) @map("rate_limit_per_minute")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  issues       Issue[]
  events       Event[]
  releases     Release[]
  alertRules   AlertRule[]

  @@unique([organizationId, slug])
  @@map("projects")
}

/// Aggregated error group after grouper runs.
/// Grouper 聚合后的错误分组。
model Issue {
  id          String      @id @default(cuid())
  projectId   String      @map("project_id")
  /// Grouping fingerprint (hash). 聚合指纹（哈希）。
  fingerprint String
  /// Short display title (usually exception message). 展示标题（通常为异常消息）。
  title       String
  status      IssueStatus @default(UNRESOLVED)
  /// Max severity seen on the issue. 该 Issue 出现的最高严重级别。
  level       String      @default("error")
  firstSeen   DateTime    @map("first_seen")
  lastSeen    DateTime    @map("last_seen")
  /// Number of distinct events merged into this issue. 合并进该 Issue 的事件数。
  eventCount  Int         @default(0) @map("event_count")
  /// Distinct users affected (MVP counter). 受影响用户数（MVP 计数）。
  usersSeen   Int         @default(0) @map("users_seen")
  /// Primary source location for UI. UI 展示的主要来源位置。
  culprit     String?
  /// Whether culprit frame is application code (vs third-party). culprit 帧是否为应用代码（相对三方库）。
  culpritInApp Boolean? @map("culprit_in_app")
  /// Latest event exception type (e.g. TypeError). 最近事件的异常类型。
  exceptionType String? @map("exception_type")
  /// Latest event capture mechanism (e.g. onerror). 最近事件的捕获机制。
  mechanism     String? @map("mechanism")
  /// Latest event environment (denormalized). 最近事件环境。
  environment String?
  /// Latest event release (denormalized). 最近事件 release。
  release     String?
  /// Comma-separated tags rollup (denormalized). 标签汇总。
  tags        String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events   Event[]
  comments IssueComment[]

  @@unique([projectId, fingerprint])
  @@index([projectId, status, lastSeen])
  @@index([projectId, environment])
  @@index([projectId, release])
  @@map("issues")
}

/// Raw event payload from the SDK (Lite: PostgreSQL JSONB).
/// SDK 上报的原始事件（Lite：PostgreSQL JSONB）。
model Event {
  id           String    @id @default(cuid())
  projectId    String    @map("project_id")
  /// SDK-generated event_id for idempotent ingest. SDK 生成的 event_id（ingest 幂等）。
  eventId      String    @map("event_id")
  issueId      String?   @map("issue_id")
  /// Event kind: error or performance transaction. 事件类型。
  eventType    EventType @default(ERROR) @map("event_type")
  /// Full event JSON (ErrorEvent or TransactionEvent). 完整事件 JSON。
  payload      Json
  /// Event timestamp from the SDK. SDK 事件时间戳。
  timestamp    DateTime
  /// Set when grouper has processed this row. Grouper 处理完成时间。
  aggregatedAt DateTime? @map("aggregated_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue   Issue?  @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@unique([projectId, eventId])
  @@index([projectId, timestamp])
  @@index([projectId, eventType, timestamp])
  @@index([issueId, timestamp])
  @@index([aggregatedAt])
  @@map("events")
}

/// SDK release version for Source Map association.
/// SDK Release 版本（关联 Source Map）。
model Release {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  /// Release version string (matches SDK init release). Release 版本字符串。
  version   String
  createdAt DateTime @default(now()) @map("created_at")

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artifacts Artifact[]

  @@unique([projectId, version])
  @@map("releases")
}

/// Source map artifact for a release.
/// Release 下的 Source Map 制品。
model Artifact {
  id         String   @id @default(cuid())
  releaseId  String   @map("release_id")
  /// Original minified filename (e.g. app.js.map). 原始文件名。
  name       String
  /// Source map JSON content. Source map JSON 内容。
  sourceMap  String   @map("source_map") @db.Text
  /// Normalized bundle URL for stack frame matching. 用于栈帧匹配的 bundle URL。
  bundleUrl  String?  @map("bundle_url")
  /// Debug id from map or upload metadata. 来自 map 或上传元数据的 debug id。
  debugId    String?  @map("debug_id")
  /// Artifact kind: map | source. 制品类型。
  artifactType String @default("map") @map("artifact_type")
  /// Content checksum for dedup/diagnostics. 内容校验和。
  checksum   String?
  createdAt  DateTime @default(now()) @map("created_at")

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, name])
  @@index([releaseId, debugId])
  @@index([releaseId, bundleUrl])
  @@map("artifacts")
}

/// Alert notification rule (Phase 21).
/// 告警通知规则。
model AlertRule {
  id         String        @id @default(cuid())
  projectId  String        @map("project_id")
  name       String
  trigger    AlertTrigger
  webhookUrl String?       @map("webhook_url")
  emailTo    String?       @map("email_to")
  enabled    Boolean       @default(true)
  threshold  Int?
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, enabled])
  @@map("alert_rules")
}

/// Issue activity comment.
/// Issue 活动评论。
model IssueComment {
  id        String   @id @default(cuid())
  issueId   String   @map("issue_id")
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
  @@map("issue_comments")
}

/// Issue lifecycle status. Issue 生命周期状态。
enum IssueStatus {
  UNRESOLVED
  RESOLVED
  IGNORED
}

/// Stored event kind. 存储的事件类型。
enum EventType {
  ERROR
  TRANSACTION
}

/// Alert trigger type. 告警触发类型。
enum AlertTrigger {
  NEW_ISSUE
  ERROR_RATE
}
