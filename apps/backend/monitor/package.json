{
  "name": "@sentry-guardian/backend-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @sentry-guardian/backend-monitor^... run build",
    "build": "tsc -p tsconfig.json",
    "predev": "pnpm --filter @sentry-guardian/backend-monitor^... run build",
    "dev": "bash ../../../scripts/dev-nest-backend.sh",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@sentry-guardian/database": "workspace:*",
    "@sentry-guardian/nest-prisma": "workspace:*",
    "@sentry-guardian/types": "workspace:*",
    "@sentry-guardian/utils": "workspace:*",
    "bcryptjs": "^3.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.29",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "license": "ISC"
}
