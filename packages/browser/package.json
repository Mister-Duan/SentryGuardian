{
  "name": "@sentry-guardian/browser",
  "version": "0.1.0",
  "description": "Browser SDK for SentryGuardian",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./performance": {
      "import": {
        "types": "./dist/performance.d.ts",
        "default": "./dist/performance.js"
      },
      "require": {
        "types": "./dist/performance.d.cts",
        "default": "./dist/performance.cjs"
      }
    },
    "./tracing": {
      "import": {
        "types": "./dist/tracing.d.ts",
        "default": "./dist/tracing.js"
      },
      "require": {
        "types": "./dist/tracing.d.cts",
        "default": "./dist/tracing.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/performance.ts src/tracing.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts src/performance.ts src/tracing.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sentry-guardian/browser-utils": "workspace:*",
    "@sentry-guardian/core": "workspace:*",
    "@sentry-guardian/types": "workspace:*",
    "perfume.js": "^9.4.0"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "license": "ISC"
}
