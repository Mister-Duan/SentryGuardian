{
  "name": "SentryGuardian",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight frontend monitoring system for self-hosting",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "spellcheck": "cspell --config .cspell/cspell.json --no-progress .",
    "dev": "pnpm --parallel --filter @sentry-guardian/backend-dsn --filter @sentry-guardian/backend-monitor --filter @sentry-guardian/frontend-monitor run dev",
    "predev:packages": "pnpm --filter @sentry-guardian/browser... run build",
    "dev:packages": "pnpm --parallel --filter @sentry-guardian/types --filter @sentry-guardian/utils --filter @sentry-guardian/browser-utils --filter @sentry-guardian/core --filter @sentry-guardian/browser run dev",
    "dev:full": "bash scripts/dev-full.sh",
    "dev:example": "pnpm --filter @sentry-guardian/example-vanilla dev",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "jsdom": "^26.1.0",
    "cspell": "^9.6.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.2.1"
  },
  "keywords": ["monitoring", "sentry", "frontend", "self-hosted"],
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  }
}
